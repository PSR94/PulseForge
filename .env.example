PULSEFORGE_ENV=development
PULSEFORGE_AI_PROVIDER=mock
PULSEFORGE_DATABASE_URL=postgresql+psycopg://pulseforge:pulseforge@postgres:5432/pulseforge
PULSEFORGE_REDIS_URL=redis://redis:6379/0
PULSEFORGE_NATS_URL=nats://nats:4222
PULSEFORGE_MAX_DOWNLOAD_BYTES=5000000
PULSEFORGE_ALLOWED_CONTENT_TYPES=text/html,application/xml,text/xml,application/rss+xml,application/atom+xml,application/json,text/plain
NEXT_PUBLIC_PULSEFORGE_API_URL=http://localhost:8000
