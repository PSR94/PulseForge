# PulseForge runtime
PULSEFORGE_ENV=development
PULSEFORGE_LOG_LEVEL=INFO
PULSEFORGE_DEMO_MODE=true
PULSEFORGE_REPOSITORY_MODE=demo

# Authentication
PULSEFORGE_AUTH_MODE=local
PULSEFORGE_JWT_SECRET=replace-this-before-production
PULSEFORGE_ACCESS_TOKEN_MINUTES=480

# AI provider: mock | openai | azure_openai | local
PULSEFORGE_AI_PROVIDER=mock
PULSEFORGE_OPENAI_API_KEY=
PULSEFORGE_OPENAI_MODEL=gpt-5.6
PULSEFORGE_AZURE_OPENAI_API_KEY=
PULSEFORGE_AZURE_OPENAI_ENDPOINT=
PULSEFORGE_AZURE_OPENAI_DEPLOYMENT=
PULSEFORGE_LOCAL_AI_BASE_URL=http://host.docker.internal:11434/v1
PULSEFORGE_LOCAL_AI_MODEL=qwen3:8b

# Data infrastructure
PULSEFORGE_DATABASE_URL=postgresql+psycopg://pulseforge:pulseforge@localhost:5432/pulseforge
PULSEFORGE_REDIS_URL=redis://localhost:6379/0
PULSEFORGE_NATS_URL=nats://localhost:4222
PULSEFORGE_STREAM_NAME=PULSEFORGE
PULSEFORGE_STREAM_SUBJECT_PREFIX=pulseforge

# Ingestion safety
PULSEFORGE_MAX_DOWNLOAD_BYTES=5000000
PULSEFORGE_UPLOAD_MAX_BYTES=10000000
PULSEFORGE_INGESTION_TIMEOUT_SECONDS=15
PULSEFORGE_MAX_REDIRECTS=5

# API / observability
PULSEFORGE_RATE_LIMIT_PER_MINUTE=120
PULSEFORGE_ENABLE_METRICS=true
PULSEFORGE_ENABLE_TRACING=true
PULSEFORGE_OTLP_ENDPOINT=
PULSEFORGE_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Web
NEXT_PUBLIC_PULSEFORGE_API_URL=http://localhost:8000
PULSEFORGE_SERVER_API_URL=http://api:8000
